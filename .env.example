# MySql
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/murder_mystery?charset=utf8mb4
ECHO=false
POOL_SIZE=10
MAX_OVERFLOW=20

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=90
WS_MAX_CONNECTIONS=32
WS_MAX_MESSAGE_BYTES=65536
WS_SEND_TIMEOUT=10

# 游戏流程（时间单位：秒）
GAME_TALK_ROUNDS=2
GAME_AI_TALK_TIMEOUT=120
GAME_HUMAN_TALK_TIMEOUT=180
GAME_PRIVATE_DURATION=180
GAME_AI_IDENTIFY_TIMEOUT=180
GAME_HUMAN_IDENTIFY_TIMEOUT=300
GAME_DISCONNECT_TIMEOUT=300
GAME_MAX_PRIVATE_REPLIES=3
# 记忆存档目录，留空则为项目根目录下的 logs/
GAME_LOG_DIR=

# 跨域来源，逗号分隔。留空则只放行 localhost:3000
CORS_ORIGINS=

# LLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_ID=deepseek-v4-flash
LLM_TIMEOUT=60

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_TIMEOUT=60

# 本地图片存储（可选，配置后优先于OSS，生成的图片保存到本地并返回本地路径）
LOCAL_IMAGE_DIR=

# 阿里云 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_CUSTOM_DOMAIN=